# =============================================================================
# Disparador WhatsApp - Variáveis de ambiente
# =============================================================================
# Copie este arquivo como `.env` e preencha com seus valores reais.
# NUNCA suba o arquivo .env para o repositório (ele já está no .gitignore).

# -----------------------------------------------------------------------------
# Servidor backend
# -----------------------------------------------------------------------------
PORT=3001
NODE_ENV=development

# Opcional: URL do dcz-crm-sync para carregar consultores acadêmicos em dev local
# (ex.: http://127.0.0.1:5000/api/disparador_whatsapp/consultores-academicos).
# Em produção o iframe do CRM injeta consultores_json na URL — não precisa.
# DCZ_CONSULTORES_URL=

# Chave opcional para proteger rotas de escrita (upload, disparo, etc.).
# Se definida, envie no header x-api-key ou Authorization: Bearer <chave>.
# No frontend (Vite), use o mesmo valor em VITE_APP_API_KEY.
APP_API_KEY=
# VITE_APP_API_KEY=

# -----------------------------------------------------------------------------
# DataCrazy (CRM) — opcional
# -----------------------------------------------------------------------------
# Token Bearer fornecido pela DataCrazy (sem o prefixo "Bearer ").
DATACRAZY_API_KEY=
# URL base real conforme docs.datacrazy.io (servers do OpenAPI).
DATACRAZY_BASE_URL=https://api.g1.datacrazy.io
# Base do CRM (campos adicionais). Se omitido, deriva de DATACRAZY_BASE_URL (api → crm).
# DATACRAZY_CRM_BASE_URL=https://crm.g1.datacrazy.io

# -----------------------------------------------------------------------------
# Novo CRM EduIT (migração) — scaffolding; NÃO troca o envio WhatsApp atual
# -----------------------------------------------------------------------------
# Deixe NOVO_CRM_ENABLED=0 até o cutover. Com 0, Disparador segue DataCrazy.
# Sem NOVO_CRM_API_BASE_URL o client falha fechado (não há default de produção).
# NOVO_CRM_ENABLED=0
# NOVO_CRM_API_BASE_URL=https://crm-dev-frontend.ca31ey.easypanel.host
# NOVO_CRM_API_TOKEN=
# Scripts DEV-only preferem token dedicado (não misturar com prod no .env):
# NOVO_CRM_DEV_API_TOKEN=
# NOVO_CRM_DEV_API_BASE_URL=https://crm-dev-frontend.ca31ey.easypanel.host
# NOVO_CRM_DATABASE_URL=
# NOVO_CRM_RETENCAO_QUESTION=Retido?
#
# === Receita PROD — sync noturna calm (madrugada BRT; FLAGS OFF) ==============
# Colar no Easypanel / secrets de produção (NÃO no .env local de DEV):
#
#   NOVO_CRM_ENABLED=1
#   NOVO_CRM_API_BASE_URL=https://integrations.bwipo.com
#   NOVO_CRM_API_TOKEN=<token prod>
#   NOVO_CRM_PROVISION_ALLOW_PROD=1
#
#   # Espelho local (contacts/deals) — full ~02:00 BRT
#   NOVO_CRM_CACHE_ENABLED=1
#   NOVO_CRM_CACHE_SOURCE=api
#   NOVO_CRM_CACHE_FETCH_DEAL_FIELDS=0
#   NOVO_CRM_CACHE_FULL_HOUR_UTC=5
#   NOVO_CRM_CACHE_API_DEAL_CONCURRENCY=1
#   NOVO_CRM_CACHE_API_DEAL_DELAY_MS=250
#   NOVO_CRM_CACHE_BATCH_DELAY_MS=50
#
#   # Rate: catch-up Full Sync = 5; dia-a-dia = 2 (teto código 6)
#   NOVO_CRM_API_RATE_PER_SECOND=2
#
#   # Provision NOTURNO OFF (28/07) — matriculados é D-1; leads novos = botão de dia
#   NOVO_CRM_PROVISION_ENABLED=0
#   NOVO_CRM_PROVISION_NEW_MAX_PER_RUN=200
#   NOVO_CRM_PROVISION_CONCURRENCY=2
#
#   # Att campos SIAA em deals existentes — ~05:00 BRT (após cache)
#   NOVO_CRM_FIELDS_SYNC_ENABLED=1
#   NOVO_CRM_FIELDS_SYNC_HOUR_UTC=8
#
#   # Etapas/flags: MANUAIS via botão «Att de etapas» — NÃO ligar cron em PROD
#   NOVO_CRM_FLAGS_SYNC_ENABLED=0
#
#   # IDs de etapa/campo PROD (obrigatório — defaults no código = DEV)
#   # Rode: node --env-file=.env scripts/novo-crm-discover-prod-ids.mjs
#   NOVO_CRM_STAGE_*=...
#   NOVO_CRM_FIELD_*=...
#
# Cron stagger (UTC → BRT = UTC-3) — receita 28/07:
#   cache full 05:00 UTC (02:00 BRT) → fields 08:00 (05:00 BRT)
#   PROVISION cron OFF. FLAGS cron OFF.
#   Dia (Disparador): Full Sync · Att de etapas · Criação de leads novos.
# Gate de escrita PROD: NOVO_CRM_PROVISION_ALLOW_PROD=1 + URL explícita
#   (libera writers manuais de provision/fields/flags; crons ainda exigem *_ENABLED=1).
# =============================================================================
#
# Cache local contacts/deals do Novo CRM. Full noturno pode demorar ~1h;
# prioridade é gentileza/completude, não velocidade.
# NOVO_CRM_CACHE_ENABLED=1
# Fonte do espelho: api (token HTTP / org do token) | db (Postgres) | auto
# NOVO_CRM_CACHE_SOURCE=api
# Buscar GET /deals/:id (CPF/RGM/custom) — caro (~1 req/contato). Default 0; fields noturno cobre SIAA.
# NOVO_CRM_CACHE_FETCH_DEAL_FIELDS=0
# Teto global de chamadas HTTP ao CRM (sync + enrich + tags). Default 2/s; teto código 6.
# Catch-up Full Sync: 5 + FETCH_DEAL_FIELDS=0. Dia-a-dia: 2.
# NOVO_CRM_API_RATE_PER_SECOND=2
# NOVO_CRM_CACHE_API_DEAL_CONCURRENCY=1
# NOVO_CRM_CACHE_API_DEAL_DELAY_MS=250
# NOVO_CRM_CACHE_API_CONTACT_PER_PAGE=200
# NOVO_CRM_CACHE_INCREMENTAL_MINUTES=15
# Full cache: default 05:00 UTC = 02:00 BRT
# NOVO_CRM_CACHE_FULL_HOUR_UTC=5
# NOVO_CRM_CACHE_BATCH_SIZE=300
# NOVO_CRM_CACHE_BATCH_DELAY_MS=250
# NOVO_CRM_CACHE_INCREMENTAL_MAX_BATCHES=20
#
# Provision matriculados → CRM. Cron OFF por padrão (28/07).
# Botão «Criação de leads novos» = mode=new (não exige PROVISION_ENABLED).
# mode=all (backfill) exige PROVISION_ENABLED=1.
# Host allowlist: crm-dev-frontend… / localhost. Outros *-dev* só com ALLOW_DEV_HOSTS=1.
# PROD: ALLOW_PROD=1 + URL explícita (mesmo gate libera fields/flags writers).
# NOVO_CRM_PROVISION_ENABLED=0
# NOVO_CRM_PROVISION_MAX_PER_RUN=1000
# NOVO_CRM_PROVISION_NEW_MAX_PER_RUN=200
# NOVO_CRM_PROVISION_CONCURRENCY=2
# NOVO_CRM_PROVISION_HOUR_UTC=7
# NOVO_CRM_PROVISION_ALLOW_PROD=0
# NOVO_CRM_PROVISION_ALLOW_DEV_HOSTS=0
# NOVO_CRM_PROVISION_MAX_ERRORS=25
#
# Att campos SIAA (curso/polo/situação…) em deals existentes — noite.
# Mesmo gate de host que provision (ALLOW_PROD libera PROD). Sequencial (1 deal por vez).
# NOVO_CRM_FIELDS_SYNC_ENABLED=1
# Fields: default 08:00 UTC = 05:00 BRT (após cache full)
# NOVO_CRM_FIELDS_SYNC_HOUR_UTC=8
#
# Sync flags + etapas: botão manual «Att de etapas» (gate de host).
# Cron só se FLAGS_SYNC_ENABLED=1 — em PROD manter =0.
# Intocáveis (não move): Ganho / Cancelado; Retenção sem CAA open (manual).
# CAA→Retenção só nas primeiras N horas (data_chegada / first_seen_at).
# NOVO_CRM_FLAGS_SYNC_ENABLED=0
# NOVO_CRM_FLAGS_SYNC_HOUR_UTC=9
# NOVO_CRM_FLAGS_SYNC_MAX_ERRORS=50
# NOVO_CRM_CAA_RETENCAO_HOURS=72
# Att: workers + rate. PROD 25/08: 5 workers + 4 rps travou o CRM. Default 2 workers + 2 rps; teto 6 rps / 4 workers. Catch-up: rate 5, workers 2.
# NOVO_CRM_FLAGS_SYNC_CONCURRENCY=2
# NOVO_CRM_FLAGS_SYNC_LIVE_STAGE=0
# NOVO_CRM_API_RATE_PER_SECOND=2
# NOVO_CRM_API_TIMEOUT_MS=15000
# Saída (passo inverso): ratio mínimo nRows/simCount pra permitir limpar Sim→Não
# ou sair de Sem Rematricula. Base com poucas linhas (upload incompleto) pula a
# saída inteira dessa fila (nRows===0 também pula sempre).
# NOVO_CRM_FLAGS_EXIT_SANITY_RATIO=0.7
#
# IDs de etapa/campo — defaults no código = CRM DEV.
# Em PROD rode: node --env-file=.env scripts/novo-crm-discover-prod-ids.mjs
# e cole NOVO_CRM_STAGE_* / NOVO_CRM_FIELD_* (ou use data/novo-crm-prod-ids.json
# via scripts/novo-crm-reclassify-prod.mjs). Valor "-" desliga o fallback DEV.
# NOVO_CRM_STAGE_EM_ATENDIMENTO=   # PROD: intocável p/ auto-move de etapa
# NOVO_CRM_STAGE_LEAD_ENTRADA=
# NOVO_CRM_STAGE_ACOLHIMENTO=
# NOVO_CRM_STAGE_GRADUACAO=
# NOVO_CRM_STAGE_POS=
# NOVO_CRM_STAGE_RETENCAO=
# NOVO_CRM_STAGE_SEM_REMATRICULA=
# NOVO_CRM_STAGE_CANCELADO=
# NOVO_CRM_STAGE_GANHO=
# NOVO_CRM_STAGE_PERDIDO=
# NOVO_CRM_FIELD_CPF=
# NOVO_CRM_FIELD_RGM=
# NOVO_CRM_FIELD_CURSO=
# NOVO_CRM_FIELD_DATA_MATRICULA=
# TEXT `data_de_rematricula` (PROD id em data/novo-crm-prod-ids.json). 1ª aparição SIAA vs última remat.
# NOVO_CRM_FIELD_DATA_REMATRICULA=cmt7bc5opxal0la01nad5ahj5
# SELECT Motivo Perda (Sem resposta, Financeiro, Outro Polo, Tempo, Desemprego).
# O funil exige o campo nativo lostReason ao mover para Perdido; este SELECT só recebe
# o rótulo quando ele existe nas opções. Id em data/novo-crm-prod-ids.json.
# NOVO_CRM_FIELD_MOTIVO_PERDA=cmsdgzeip02ztmy01rhle73b0
# SELECT Pré/Pós (marco regulatório). PROD: name marco_regulatorio_2, label "Marco Regulatorio".
# Id em data/novo-crm-prod-ids.json. Sem id a Att/fields não grava. Valores exatamente Pré / Pós.
# NOVO_CRM_FIELD_MARCO=cmst97c9q01a7mp019n6671ji
# NOVO_CRM_FIELD_POLO=
# NOVO_CRM_FIELD_SITUACAO=
# NOVO_CRM_FIELD_NIVEL=
# NOVO_CRM_FIELD_DOC_PENDENTES=
# Situação Financeira / inadimplentes-vencidos (PROD field name `situacaofinanceira`, label Financeira).
# NÃO use "-" em PROD — isso desliga o flag e a Att não grava Inad/Financeira.
# NOVO_CRM_FIELD_INADIMPLENTE=
# Financeiro (base slug `financeiro` = mensalidade aberta ainda no prazo/desconto).
# Separado de situacaofinanceira. PROD field = label "Dia 10", name `dia` (SELECT Sim/Não),
# NÃO um field name/label "financeiro". Id em data/novo-crm-prod-ids.json (NOVO_CRM_FIELD_FINANCEIRO) ou:
# NOVO_CRM_FIELD_FINANCEIRO=cmsoqzzbwgs3yom01n0c5txvi
# CAA. SELECT Sim/Não, name `caa`, label CAA.
# O XLSX do dia é D−1 (quem estava ontem não está hoje) — Sim é sticky em quem
# já apareceu em caa_protocols (qualquer status). NÃO há passo inverso Sim→Não.
# Retenção = open ≤72h. Sem id no JSON/env a Att não grava.
# NOVO_CRM_FIELD_CAA=cmt7ndc0k00nnp801ngjfqf98
# Campo "Atualizado?" — Sim só quando grava campos SIAA (CPF/RGM/polo/curso/situacao/…);
# NÃO em move-only, flags-only nem clear vazio. Ver AGENTS.md 2026-08-04.
# NOVO_CRM_FIELD_ATUALIZADO=cms9c1gfk0sl0jq011ywjyxfo
# NOVO_CRM_FIELD_ACESSO_BLACK=
# NOVO_CRM_FIELD_EVASAO=
#
# Reclassify PROD (Lead de Entrada → fase): discover → cache full → dry → apply
#   node --env-file=.env scripts/novo-crm-discover-prod-ids.mjs
#   node --env-file=.env scripts/novo-crm-cache-full-sync.mjs --truncate
#   node --env-file=.env scripts/novo-crm-reclassify-prod.mjs --dry --max=2000
#   node --env-file=.env scripts/novo-crm-reclassify-prod.mjs --apply
#
# Disparador — 3 botões (28/07):
#   Full Sync → POST /api/maintenance/sync-novo-crm-cache?mode=full&async=1
#   Att de etapas → POST /api/maintenance/sync-flags-stage-novo-crm?mode=flags_stage&dry_run=0&async=1
#   Criação de leads novos → POST /api/maintenance/provision-matriculados-novo-crm?mode=new&dry_run=0&async=1

# Tag no contact/deal: POST /api/contacts|:dealId/tags { "tagName": "ativacao-caa" }
# Mapa categoria→tag: server/utils/novoCrmActivationTags.js
# Meu Painel Novo CRM: conversation_close_tabulations (question Retido? → Sim/Não)
# Migrar histórico: POST /api/maintenance/migrate-meu-painel-legacy
# Sync cache: POST /api/maintenance/sync-novo-crm-cache?mode=full|incremental&async=1

# Campo adicional no lead preenchido após cada disparo.
# DATACRAZY_ORIGEM_ATIVACAO_FIELD=origem_ativacao
# ID do campo (último segmento da URL ao editar no CRM).
# DATACRAZY_ORIGEM_ATIVACAO_FIELD_ID=3a22bd69-4578-4740-87c1-29e72fbbac22
# Modo de lookup: hybrid (default) | cache_only | bulk_search | cache_first
# cache_only = só snapshot Postgres (sync madrugada) — zero ?search= no disparo
# hybrid = cache + prefetch CPF controlado (~6/s) + envio WhatsApp
# DATACRAZY_ACTIVATION_LOOKUP_MODE=hybrid
# No disparo, usa cache mesmo se TTL > 7 dias (default 1 = sim)
# DATACRAZY_ACTIVATION_USE_STALE_CACHE=1
# Prefetch: paralelismo e pausa entre lotes (default 3 / 150ms)
# DATACRAZY_PREFETCH_CONCURRENCY=3
# DATACRAZY_PREFETCH_GAP_MS=150
# Buscas API paralelas por lead no envio (default 4)
# DATACRAZY_RESOLVE_CONCURRENCY=4
# Rate limit global de GET/PUT no CRM (default 6/s — respeita limites DataCrazy).
# DATACRAZY_CRM_RATE_PER_SECOND=7
# Sync manual: tamanho de página e pausa (default 200 / 200ms — ~2× mais rápido que 100/400)
# DATACRAZY_CACHE_SYNC_PAGE_SIZE=200
# DATACRAZY_CACHE_SYNC_PAGE_DELAY_MS=200
# Paralelismo da busca direta no preflight (default 4).
# DATACRAZY_DIRECT_SEARCH_CONCURRENCY=4
# Pausa entre lotes paralelos, em ms (default 250).
# DATACRAZY_DIRECT_SEARCH_DELAY_MS=250
# Cooldown após 429 antes de retentar (default 2000 ms).
# DATACRAZY_RATE_LIMIT_COOLDOWN_MS=2000
# Tentativas por termo no lote paralelo (default 5).
# DATACRAZY_SEARCH_MAX_ATTEMPTS=5
# Retry serial pós-429: tentativas e intervalo (default 8 / 500 ms).
# DATACRAZY_SERIAL_RETRY_MAX_ATTEMPTS=8
# DATACRAZY_SERIAL_RETRY_GAP_MS=500
# Envios simultâneos no loop de disparo (default 10).
# ACTIVATION_BATCH_CONCURRENCY=10
# Blocos automáticos quando o lote excede este tamanho (default 500).
# ACTIVATION_AUTO_CHUNK_SIZE=500
# Pausa entre blocos automáticos, em ms (default 15000 = 15s).
# ACTIVATION_CHUNK_PAUSE_MS=15000

# RGM institucional Cruzeiro EAD — prefixo de 2 dígitos (série histórica 20+; viradas 50…).
# INSTITUTIONAL_RGM_PREFIX_MIN=20
# INSTITUTIONAL_RGM_PREFIX_MAX=52

# -----------------------------------------------------------------------------
# WhatsApp Cloud API (Meta) — provedor recomendado para envio em massa
# -----------------------------------------------------------------------------
# Access Token permanente da Meta (System User token).
WHATSAPP_API_KEY=
# URL base da Graph API.
WHATSAPP_BASE_URL=https://graph.facebook.com/v20.0
# ID da conta WABA (WhatsApp Business Account). NÃO é o Phone Number ID!
WHATSAPP_BUSINESS_ACCOUNT_ID=
# ID do número de telefone — obrigatório para envio via Cloud API.
WHATSAPP_PHONE_NUMBER_ID=

# -----------------------------------------------------------------------------
# Providers (templates e envio)
# -----------------------------------------------------------------------------
#   whatsapp  → Meta Cloud API direto  (recomendado)
#   datacrazy → CRM DataCrazy
TEMPLATES_PROVIDER=whatsapp
MESSAGES_PROVIDER=whatsapp

# -----------------------------------------------------------------------------
# Throttling de envio
# -----------------------------------------------------------------------------
# Intervalo mínimo absoluto entre envios (segundos). O backend nunca usa
# valor menor que este, mesmo se o usuário escolher 0 no front.
# Recomendado pela Meta para marketing: 1–3s para preservar Quality Rating.
MIN_INTERVAL_SECONDS=1

# -----------------------------------------------------------------------------
# Banco de dados (Postgres ou Supabase)
# -----------------------------------------------------------------------------
# Connection string completa. Exemplos:
#   Postgres local:  postgresql://postgres:senha@localhost:5432/disparador
#   Supabase:        postgresql://postgres.<ref>:senha@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Quando true, força SSL com rejectUnauthorized=false (necessário em Supabase/RDS).
DATABASE_SSL=true

# -----------------------------------------------------------------------------
# Webhook
# -----------------------------------------------------------------------------
# Verify token usado pela Meta no GET de verificação do webhook (/api/webhooks/whatsapp).
WEBHOOK_VERIFY_TOKEN=mude_esse_valor

# Janela (em horas) usada para correlacionar mensagens inbound a uma campanha.
WEBHOOK_MATCH_WINDOW_HOURS=168

# -----------------------------------------------------------------------------
# Régua Inteligente — Scheduler in-process
# -----------------------------------------------------------------------------
# Habilita o scheduler que processa scheduled_events a cada SCHEDULER_INTERVAL_MS.
# Em produção pode ser desligado se você rodar um worker externo no lugar.
SCHEDULER_ENABLED=true
# Intervalo entre ciclos (ms). 60000 = 60s.
SCHEDULER_INTERVAL_MS=60000
# Tamanho do lote reivindicado por ciclo (FOR UPDATE SKIP LOCKED).
SCHEDULER_BATCH_SIZE=50
# Após quantos minutos um lock 'processing' é considerado órfão e liberado.
SCHEDULER_STALE_LOCK_MIN=10

# -----------------------------------------------------------------------------
# Régua Inteligente — Email (canal complementar ao WhatsApp)
# -----------------------------------------------------------------------------
#   mock     → loga no console (default em dev)
#   resend   → integra com Resend (TODO [CURSOR])
#   smtp     → SMTP genérico (TODO [CURSOR])
#   sendgrid → SendGrid (TODO [CURSOR])
EMAIL_PROVIDER=mock
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS="Plataforma <noreply@suaempresa.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# -----------------------------------------------------------------------------
# Importação de bases (Bases → upload CSV/XLSX)
# -----------------------------------------------------------------------------
# Máximo de linhas por arquivo (padrão 120000; planilha provável evasão ~102k).
# BASE_UPLOAD_MAX_ROWS=120000

# -----------------------------------------------------------------------------
# Onda 2: cache persistente cpf → datacrazy_lead_id
# Reduz disparos de 10k leads de ~17min pra ~3s quando cache cheio.
# -----------------------------------------------------------------------------
# 1 (ligado) ou 0 (desligado). Default: 1.
DATACRAZY_CACHE_ENABLED=1
# Hora UTC do cron noturno de sync (0–23, default 3 = 03:00 UTC).
DATACRAZY_CACHE_SYNC_HOUR_UTC=3
# Safety limit de páginas do sync (default 2000, cobre ~200k leads).
DATACRAZY_CACHE_SYNC_MAX_PAGES=2000
# Quantos dias um lead pode ficar sem re-sync antes do cache ser invalidado.
# Default: 7.
DATACRAZY_CACHE_TTL_DAYS=7

# -----------------------------------------------------------------------------
# Anotação automática no DataCrazy a cada envio do disparador.
# Quando true (default), POST /api/v1/leads/{leadId}/notes a cada mensagem enviada.
# Desligue ('false') se a API do DataCrazy ficar instável.
# -----------------------------------------------------------------------------
# Grava anotação no card do lead após cada envio (default true).
DATACRAZY_DISPATCH_NOTE_ENABLED=true
# Desliga anotações automaticamente acima de N envios no mesmo lote (default 250).
# DATACRAZY_DISPATCH_NOTE_MAX_BATCH=250
# Lotes acima disso usam busca direta por CPF/e-mail (default 5000 — evita paginar CRM inteiro).
# DATACRAZY_DIRECT_SEARCH_THRESHOLD=5000
